{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "security-quiz",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // KV（進捗の保存先）：なまえ＋4桁PINのハッシュをキーに、問題ごとの正誤を保存する
  "kv_namespaces": [
    { "binding": "PROGRESS", "id": "0c0e4ad926234ce58564fb789914ef0d" }
  ],
  "observability": { "enabled": true }
}
